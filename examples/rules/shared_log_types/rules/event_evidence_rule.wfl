// 证据规则: log_type **不在**安全日志允许列表 → 普通日志出证据（每条一条）。
//
// 同样 use 导入同一份列表——`not in` 引用与 `in` 引用共享同一数据源。
use "../lists/security_log_types.wfl"

rule event_evidence_rule {
    events { s : sdm_event && s.log_type not in security_log_types }
    on each s -> score(40.0)
    entity(ip, s.src_ip)
    yield event_evidence (
        log_type = s.log_type,
        src_ip = s.src_ip
    )

    limits {
        max_memory = "64MB";
        max_instances = 10000;
        on_exceed = throttle;
    }
}

test evidence_for_non_security_logs for event_evidence_rule {
  input {
    row(s, log_type = "edr_alert_log", src_ip = "10.0.0.1", dst_ip = "192.168.1.10", user = "alice", event_time = "2026-01-01T00:00:00Z");
    row(s, log_type = "app_access_log", src_ip = "10.0.0.2", dst_ip = "192.168.1.20", user = "bob", event_time = "2026-01-01T00:00:01Z");
    row(s, log_type = "mail_smtp_log", src_ip = "10.0.0.4", dst_ip = "192.168.1.40", user = "dave", event_time = "2026-01-01T00:00:03Z");
  }
  expect { hits == 2; }
}
