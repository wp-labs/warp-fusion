// 实体规则: log_type 命中安全日志允许列表 → 按 src_ip 输出实体。
//
// 与 alert_rule 引用**同一份**列表（use 导入 + `in` 引用）——列表只维护一处。
use "shared/security_log_types.wfl"

rule alert_entity_rule {
    events { s : sdm_event && s.log_type in security_log_types }
    match<s.src_ip:1m> { on event { s | count >= 1; } } -> score(60.0)
    entity(ip, s.src_ip)
    yield alert_entities (
        src_ip = s.src_ip,
        log_type = s.log_type
    )

    limits {
        max_memory = "64MB";
        max_instances = 10000;
        on_exceed = throttle;
    }
}

test entity_per_matching_source for alert_entity_rule {
  input {
    row(s, log_type = "edr_alert_log", src_ip = "10.0.0.1", dst_ip = "192.168.1.10", user = "alice", event_time = "2026-01-01T00:00:00Z");
    row(s, log_type = "fw_ips_protect_log", src_ip = "10.0.0.2", dst_ip = "192.168.1.11", user = "bob", event_time = "2026-01-01T00:00:05Z");
    row(s, log_type = "app_access_log", src_ip = "10.0.0.9", dst_ip = "192.168.1.99", user = "mallory", event_time = "2026-01-01T00:00:10Z");
  }
  expect { hits == 2; }
}
